{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "allowSyntheticDefaultImports": true,
    "noEmit": true,
    "types": []
  },
  "include": ["src/renderer/**/*", "src/shared/**/*", "src/preload/preload.ts", "src/types.d.ts"],
  "exclude": ["node_modules", "dist"]
}
